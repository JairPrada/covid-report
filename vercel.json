{
  "version": 2,
  "build": {
    "env": {
      "PYTHON_VERSION": "3.9"
    }
  },
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python"
    }
  },
  "buildCommand": "python manage.py collectstatic --noinput || true",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
